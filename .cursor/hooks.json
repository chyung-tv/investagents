{
  "version": 1,
  "hooks": {
    "stop": [
      {
        "command": ".cursor/hooks/stop-review.py",
        "loop_limit": 2
      }
    ],
    "beforeShellExecution": [
      {
        "command": ".cursor/hooks/shell-guard.py",
        "failClosed": true
      }
    ],
    "afterFileEdit": [
      {
        "command": ".cursor/hooks/schema-hint.py"
      }
    ]
  }
}
